<ui:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="True">
    <Style src="project://database/Assets/13.UIToolKit/CharacterCreater/USS/Button.uss?fileID=7433441132597879392&amp;guid=32f582e21bebd54498c3948dc3f781f8&amp;type=3#Button"/>
    <ui:Image name="BackGround" source="project://database/Assets/13.UIToolKit/CharacterCreater/5ad7199b848e6384312f14f39b2431cf.jpg?fileID=2800000&amp;guid=01bd53ed1021717439888500f810e4cd&amp;type=3#5ad7199b848e6384312f14f39b2431cf" scale-mode="StretchToFill" style="position: absolute; right: 0; left: 0; width: 100%; height: 286%;"/>
    <ui:VisualElement name="MainContainer" style="flex-grow: 1; flex-direction: column; align-items: flex-start; justify-content: space-around; align-self: stretch; width: 100%; height: 100%;">
        <ui:Label text="캐릭터 생성기" style="top: 0; position: relative; align-items: center; width: 100%; -unity-text-align: upper-center; font-size: 20px; background-color: rgba(147, 176, 46, 0.25); color: rgb(255, 255, 255); -unity-font-style: bold; text-shadow: 0 0 0 rgba(0, 0, 0, 0); -unity-text-outline-width: 1px; -unity-text-outline-color: rgb(42, 0, 87);"/>
        <ui:VisualElement name="GenWindow" style="flex-grow: 1; width: 100%; opacity: 1; height: 100%; flex-direction: row;">
            <ui:VisualElement style="flex-grow: 1; width: 100%; height: 100%;">
                <ui:TextField label="캐릭터 이름" placeholder-text="filler text" value="이름" name="NameField" style="background-color: rgba(0, 255, 255, 0.81); -unity-text-align: upper-center; border-top-left-radius: 12px; border-top-right-radius: 12px; border-bottom-right-radius: 12px; border-bottom-left-radius: 12px; color: rgb(0, 0, 0); -unity-text-outline-color: rgb(0, 0, 0); border-left-color: rgb(0, 0, 0); border-right-color: rgb(0, 0, 0); border-top-color: rgb(0, 0, 0); border-bottom-color: rgb(0, 0, 0);"/>
                <ui:IMGUIContainer name="IMGUIContainer" style="min-width: 50px; width: 100%; height: 50px; min-height: 76px;">
                    <uie:ObjectField label="모델링" name="CharacterField" type="UnityEngine.GameObject, UnityEngine.CoreModule" style="background-color: rgb(47, 0, 221); border-top-left-radius: 16px; border-top-right-radius: 16px; border-bottom-right-radius: 16px; border-bottom-left-radius: 16px; color: rgb(0, 0, 0); font-size: 14px; -unity-text-outline-width: 0; -unity-text-outline-color: rgb(0, 0, 0); margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; -unity-text-align: upper-center;"/>
                    <uie:ObjectField label="아바타" name="AvatarField" type="UnityEngine.Avatar, UnityEngine.AnimationModule" style="background-color: rgb(47, 0, 221); border-top-left-radius: 16px; border-top-right-radius: 16px; border-bottom-right-radius: 16px; border-bottom-left-radius: 16px; color: rgb(0, 0, 0); font-size: 14px; -unity-text-outline-width: 0; -unity-text-outline-color: rgb(0, 0, 0); margin-top: 0; margin-right: 0; margin-bottom: 0; margin-left: 0; -unity-text-align: upper-center;"/>
                </ui:IMGUIContainer>
                <ui:VisualElement name="ScriptableField" style="flex-grow: 1; width: 100%; height: 100%; min-height: 400px;">
                    <ui:EnumField label="캐릭터 유형" value="Player" type="CharacterKind, Assembly-CSharp-Editor" name="TypeField" style="background-color: rgb(0, 0, 0); border-top-left-radius: 9px; border-top-right-radius: 9px; border-bottom-right-radius: 9px; border-bottom-left-radius: 9px; -unity-text-align: upper-center; background-position-x: center; width: 100%; height: 100%; min-width: auto; min-height: auto; max-height: 20px;"/>
                    <ui:IntegerField label="ID" value="1" name="IDField" password="true" class="StatField" style="-unity-background-image-tint-color: rgb(0, 0, 0);"/>
                    <ui:IntegerField label="힘" value="1" name="StrengthField" password="true" class="StatField" style="-unity-background-image-tint-color: rgb(0, 0, 0);"/>
                    <ui:IntegerField label="방어력" value="1" name="DefenseField" password="true" class="StatField" style="-unity-background-image-tint-color: rgb(0, 0, 0);"/>
                    <ui:IntegerField label="민첩" value="1" name="AgilityField" password="true" class="StatField" style="-unity-background-image-tint-color: rgb(0, 0, 0);"/>
                    <ui:IntegerField label="지능" value="1" name="IntField" password="true" class="StatField" style="-unity-background-image-tint-color: rgb(0, 0, 0);"/>
                    <ui:FloatField label="공속" value="1" name="ASField" class="StatField"/>
                    <ui:FloatField label="치확" value="0" name="CCField" class="StatField"/>
                    <ui:FloatField label="치피" value="1" name="CDField" class="StatField"/>
                    <uie:ObjectField label="썸넬" name="ThumnailField" type="UnityEngine.Sprite, UnityEngine.CoreModule" class="StatField"/>
                    <ui:TextField label="설명" placeholder-text="filler text" name="DescriptionField" class="StatField" style="min-height: 123px; -unity-text-align: middle-center; text-overflow: ellipsis;"/>
                </ui:VisualElement>
                <ui:VisualElement name="GenButtons" style="flex-grow: 1; width: 100%; align-items: stretch; justify-content: flex-start; height: 100%; align-self: flex-start;">
                    <ui:Button text="생성 " name="CreateButton" focusable="false" class="BlueButton" style="min-width: 30px; min-height: 30px; -unity-font-style: normal; -unity-text-align: middle-center;"/>
                    <ui:Button text="취소" class="BlueButton"/>
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement name="PreviewArea" style="flex-grow: 1; width: 100%; height: 745px;"/>
        </ui:VisualElement>
    </ui:VisualElement>
</ui:UXML>
